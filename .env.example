# PostgreSQL connection string.
# Local dev: docker compose -f docker-compose.base44.yml up (db service), then use:
DATABASE_URL=postgresql://menu:menu_dev_password@localhost:5432/menu

# Required — Better Auth signing secret (>= 32 chars). Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional — public base URL for auth. Defaults to the request origin.
# AUTH_URL=http://localhost:3000

# Optional — file storage token. Needed from Phase 2 onward (image uploads).
# BLOB_READ_WRITE_TOKEN=
