# Postgres connection string used by the app, drizzle-kit, and tests.
# Local dev with the Base44 sandbox compose:
#   docker compose -f docker-compose.base44.yml up -d db
DATABASE_URL=postgres://qrmenu:qrmenu@localhost:5432/qrmenu

# Better Auth signing key. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the app (auth cookies, trusted origins, links).
BETTER_AUTH_URL=http://localhost:3000

# Development seed only (scripts/seed.ts): platform admin credentials.
SEED_ADMIN_EMAIL=admin@qrmenu.test
SEED_ADMIN_PASSWORD=Admin123!dev
