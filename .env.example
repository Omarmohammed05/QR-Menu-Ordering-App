# PostgreSQL connection string.
# Local dev: docker compose -f docker-compose.base44.yml up (db service), then use:
DATABASE_URL=postgresql://menu:menu_dev_password@localhost:5432/menu
# Production: Neon connection string (see docs/DEPLOYMENT.md).

# Required — Better Auth signing secret (>= 32 chars). Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required — the absolute public origin public URLs are built from
# (QR codes, sitemap, canonical/OG tags). Never derived from the request host.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — public base URL for auth. Defaults to the request origin.
# AUTH_URL=http://localhost:3000

# Optional — imgbb API key for image uploads (https://api.imgbb.com/).
# IMGBB_API_KEY=

# Optional — platform-owner email; gates the admin page and restaurant creation.
# PLATFORM_OWNER_EMAIL=
